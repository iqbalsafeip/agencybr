---
const items = [
  ['/', 'Home'],
  ['/dashboard', 'Dash'],
  ['/agents', 'Agents'],
  ['/signals', 'Signals'],
  ['/terminal', 'Terminal'],
];
---

<nav class="fixed inset-x-0 bottom-0 z-30 border-t border-white/10 bg-[#090909]/95 backdrop-blur-xl lg:hidden">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-2 py-2">
    {items.map(([href, label]) => (
      <a href={href} class="flex min-w-0 flex-1 flex-col items-center justify-center gap-1 rounded-lg px-2 py-2 text-[10px] uppercase tracking-[0.15em] text-[#dfe8e3]">
        <span class="mono text-[9px] text-[#7CFFB2]">//</span>
        <span>{label}</span>
      </a>
    ))}
  </div>
</nav>
