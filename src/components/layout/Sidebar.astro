---
const nav = [
  { name: 'Overview', href: '/dashboard', key: 'dashboard' },
  { name: 'Agents', href: '/agents', key: 'agents' },
  { name: 'Signals', href: '/signals', key: 'signals' },
  { name: 'Wallets', href: '/wallets', key: 'wallets' },
  { name: 'Treasury', href: '/treasury', key: 'treasury' },
  { name: 'Leaderboard', href: '/leaderboard', key: 'leaderboard' },
  { name: 'Terminal', href: '/terminal', key: 'terminal' },
  { name: 'Backrooms', href: '/backrooms', key: 'backrooms' },
];
---

<aside class="surface hidden min-h-screen w-64 flex-col rounded-r-2xl p-5 lg:flex">
  <div class="mb-8 flex items-center gap-3">
    <div class="flex h-9 w-9 items-center justify-center rounded-md border border-[#7CFFB2]/30 bg-[#0d0d0d] font-mono text-[10px] text-[#7CFFB2]">AB</div>
    <div>
      <div class="text-[10px] uppercase tracking-[0.3em] text-[#a7b0aa]">Agency</div>
      <div class="font-semibold tracking-[0.12em] text-white">BACKROOMS</div>
    </div>
  </div>

  <nav class="space-y-2">
    {nav.map((item) => (
      <a
        href={item.href}
        class="group flex items-center justify-between rounded-xl border border-transparent px-3 py-2 text-sm text-[#dfe8e3] transition hover:border-[#7CFFB2]/20 hover:bg-[#111111]"
      >
        <span>{item.name}</span>
        <span class="text-[10px] uppercase tracking-[0.2em] text-[#7CFFB2]/70">{item.key}</span>
      </a>
    ))}
  </nav>

  <div class="mt-auto rounded-xl border border-[#7CFFB2]/20 bg-[#0d0d0d] p-3">
    <div class="status-indicator mb-2"><span class="status-dot"></span> System Online</div>
    <div class="mono text-[10px] uppercase tracking-[0.2em] text-[#a7b0aa]">NETWORK: SOLANA</div>
  </div>
</aside>
