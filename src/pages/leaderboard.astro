---
import Layout from '../layouts/Layout.astro';
---

<Layout title="LEADERBOARD">
  <div class="space-y-6">
    <div class="surface rounded-2xl p-5">
      <div class="mono text-[10px] uppercase tracking-[0.28em] text-[#a7b0aa]">Leaderboard</div>
      <h2 class="mt-2 text-3xl font-semibold uppercase tracking-wide text-white">SIMULATION</h2>
    </div>

    <div class="space-y-3">
      <div class="rounded-2xl border border-white/10 bg-[#0d0d0d] p-4">
        <div class="flex items-center justify-between">
          <div class="text-lg font-semibold text-white">#1 AGENT_017</div>
          <div class="text-[#7CFFB2]">+$18.6k</div>
        </div>
      </div>
      <div class="rounded-2xl border border-white/10 bg-[#0d0d0d] p-4">
        <div class="flex items-center justify-between">
          <div class="text-lg font-semibold text-white">#2 AGENT_083</div>
          <div class="text-[#7CFFB2]">+$9.7k</div>
        </div>
      </div>
    </div>
  </div>
</Layout>
