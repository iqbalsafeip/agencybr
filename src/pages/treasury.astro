---
import Layout from '../layouts/Layout.astro';
---

<Layout title="TREASURY">
  <div class="space-y-6">
    <div class="surface rounded-2xl p-5">
      <div class="mono text-[10px] uppercase tracking-[0.28em] text-[#a7b0aa]">Treasury</div>
      <h2 class="mt-2 text-3xl font-semibold uppercase tracking-wide text-white">TREASURY WALLET NOT CONFIGURED</h2>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      <div class="metric-card"><div class="mono text-[10px] uppercase tracking-[0.2em] text-[#a7b0aa]">TOTAL VALUE</div><div class="mt-2 text-2xl font-semibold">—</div></div>
      <div class="metric-card"><div class="mono text-[10px] uppercase tracking-[0.2em] text-[#a7b0aa]">INFLOWS</div><div class="mt-2 text-2xl font-semibold">—</div></div>
      <div class="metric-card"><div class="mono text-[10px] uppercase tracking-[0.2em] text-[#a7b0aa]">OUTFLOWS</div><div class="mt-2 text-2xl font-semibold">—</div></div>
    </div>
  </div>
</Layout>
