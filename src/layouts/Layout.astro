---
import '../styles/global.css';
import Sidebar from '../components/layout/Sidebar.astro';
import TopBar from '../components/layout/TopBar.astro';
import MobileNav from '../components/layout/MobileNav.astro';

const { title = 'Agency Backrooms' } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="AGENCY BACKROOMS — intelligent crypto and AI operator dashboard."
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="min-h-screen">
      <TopBar title={title} />
      <div class="mx-auto flex max-w-[1600px]">
        <Sidebar />
        <main class="flex-1 px-4 pb-24 pt-6 md:px-6 lg:px-8">
          <slot />
        </main>
      </div>
      <MobileNav />
    </div>
  </body>
</html>
